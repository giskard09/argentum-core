            "admitted_payload_digest": "35dd375e2dc7d8f0c771b8868c335a859c15a23025d1afa41c7c9cdd05fdeab2"
          },
          "idempotency_ref": "02f051276a0fb93c755f17acaea961f12441a6a3b25163c965c663660e398250"
        },
        {
          "id": "case-4-drifted-retry",
          "idempotency_artifact": {
            "action_type": "payment.send",
            "agent_id": "crew-runtime-agent-042",
            "idempotency_key": "adm_4f1c9e2a",
            "scope": "mycelium:payment",
            "version": "idempotency-ref-v1.1",
            "window_ms": 300000,
            "admitted_payload_digest": "5cd9ef51eebab17d494da8b25447d4c3c826678c032246543f0f64e0d20bce5f"
          },
          "idempotency_ref": "17aeaabfb7c62af8cd630b2a55c87990d8b1133c3c9a146adb83a72babf3a2e5"
        }
      ],
      "expected_divergence": {
        "event": "case-4-drifted-retry",
        "outcome": "EXECUTE",
        "effects_after": 3
