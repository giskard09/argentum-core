    {
      "id": "malformed-structural-001",
      "description": "party_a claims observed=true but action_ref is null while co_signer is fully populated — decouples the signed claim from the thing it claims to attest, structurally invalid by construction (not a normal UNRESOLVED, since the party asserted it DID observe). Envelope hash itself is internally consistent (recomputes correctly) — only the structural_validity invariant catches this, which is the point of checking it independently of the hash.",
      "expected": "FAIL",
      "failure_mode": "structural_validity",
      "failure_detail": "party_a: observed=true but action_ref=null (must be non-null when observed=true)",
