        }
      }
    },
    {
      "id": "hc-003-mixed-preimage-mismatch",
      "description": "The preimage was altered after signing: JCS(preimage) no longer matches preimage_jcs. Any host sees that without the algorithm, so the missing capability does not soften it.",
      "expected": [
        "FAIL"
      ],
      "expected_by_host": {
        "capable": "FAIL",
        "incapable": "FAIL"
      },
      "failure_mode": "preimage_jcs_mismatch",
