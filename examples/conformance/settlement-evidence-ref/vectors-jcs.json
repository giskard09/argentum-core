        "payer_debit": {
          "address": "0xA11ce00000000000000000000000000000000001",
          "amount": "10000",
          "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
        },
        "payee_credit": {
          "address": "0x209693Bc6afc0C5328bA36FaF03C514EF312287C",
          "amount": "10000",
          "asset": "0x036CbD53842c5426634e7929541eC2318f3dCF7e"
        },
        "version": "settlement-evidence-ref-v1",
        "ext": {
          "\uffff": 2,
          "\ud83d\ude00": 1
        }
      },
      "settlement_evidence_ref": "e3ade4f297a1d9ffc243f6cd817ceac9caf6d9ac05819756cf22a1a5ad1f8a33",
